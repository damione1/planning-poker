package templates

import "github.com/damione1/planning-poker/internal/services"

func getErrorMessage(errorParam string) string {
	switch errorParam {
	case "room_expired":
		return "The room you tried to access has expired and is no longer available."
	case "room_not_found":
		return "The room you tried to access does not exist."
	default:
		return "Unknown error"
	}
}

templ Home(voteTemplates []services.TemplateInfo, errorParam string) {
	@HomeBase(errorParam) {
		<main class="py-6 px-4 lg:py-10 lg:px-8">
			<div class="max-w-7xl mx-auto space-y-16">
				<div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-start">
					<div class="space-y-4">
						@heroContent()
					</div>
					<div id="create-room" class="scroll-mt-6">
						@roomCreationForm(voteTemplates, errorParam)
					</div>
				</div>
				@planningPokerGuide()
			</div>
		</main>
	}
}

templ heroContent() {
	<div>
		<h1 class="text-3xl lg:text-5xl font-bold text-slate-900 mb-4">Online planning poker, without sign-up</h1>
		<p class="text-lg text-slate-600">Estimate story points together in real time. Create a room, join with your name, and share the link with your team.</p>
	</div>
}

templ roomCreationForm(voteTemplates []services.TemplateInfo, errorParam string) {
	<div class="elevated-card p-5 sm:p-8 bg-gradient-to-br from-white to-slate-50">
		<!-- Header -->
		<div class="mb-6">
			<h2 class="text-2xl font-bold text-slate-800 mb-2">Create a Room</h2>
			<p class="text-sm text-slate-600">Start estimating in seconds</p>
		</div>
		<!-- Error Display -->
		if errorParam != "" {
			<div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl">
				<div class="flex items-start gap-3">
					<span class="text-red-500 text-xl">⚠️</span>
					<div class="flex-1">
						<p class="text-sm font-medium text-red-900">{ getErrorMessage(errorParam) }</p>
					</div>
				</div>
			</div>
		}
		<!-- Error Container -->
		<div id="form-errors" role="alert" aria-live="polite"></div>
		<!-- Form Fields -->
		<form method="POST" action="/room" x-data="createRoomForm()" hx-post="/room" hx-target="#form-errors" hx-swap="innerHTML" class="space-y-4">
			<!-- Room Name Input -->
			<div>
				<label for="name" class="block text-sm font-semibold text-slate-700 mb-2">
					Room Name
				</label>
				<input
					type="text"
					id="name"
					name="name"
					required
					placeholder="Sprint 23 Planning"
					class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:ring-4 focus:ring-primary-200 focus:border-primary-400 outline-none transition-all duration-200 bg-white hover:border-slate-300"
				/>
			</div>
			<!-- Value Template -->
			<div>
				<label for="vote-template" class="block text-sm font-semibold text-slate-700 mb-2">
					Voting scale
				</label>
				<select
					id="vote-template"
					x-model="selectedTemplate"
					@change="updateCustomValues()"
					class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:ring-4 focus:ring-primary-200 focus:border-primary-400 outline-none transition-all duration-200 bg-white hover:border-slate-300"
				>
					for _, template := range voteTemplates {
						<option value={ template.ID }>{ template.Description }</option>
					}
				</select>
				<details class="mt-3">
					<summary class="cursor-pointer text-sm font-semibold text-primary-700 py-2">Edit the voting values</summary>
					<div class="mt-2">
						<label for="custom-values" class="block text-sm font-semibold text-slate-700 mb-2">Values separated by commas</label>
						<input type="text" id="custom-values" name="customValues" x-model="customValues" value="0.5, 1, 2, 3, 5, 8, 13, 20, 40, 100" required aria-describedby="custom-values-help" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:ring-4 focus:ring-primary-200 focus:border-primary-400 outline-none bg-white"/>
						<p id="custom-values-help" class="text-xs text-slate-600 mt-2">Use at least two values. Choosing a scale above replaces these values with its preset.</p>
					</div>
				</details>
			</div>
			<!-- Hidden field to always send 'custom' as pointing method -->
			<input type="hidden" name="pointingMethod" value="custom"/>
			<!-- Room Settings -->
			<div>
				<button
					type="button"
					@click="showSettings = !showSettings"
					aria-expanded="false"
					:aria-expanded="showSettings"
					aria-controls="room-settings"
					class="w-full flex items-center justify-between px-4 py-3 border-2 border-slate-200 rounded-xl hover:border-primary-300 hover:bg-primary-50 transition-all duration-200"
				>
					<div class="flex items-center gap-2">
						<span class="text-lg">⚙️</span>
						<span class="text-sm font-semibold text-slate-700">Room Settings (Optional)</span>
					</div>
					<svg
						aria-hidden="true"
						class="w-5 h-5 text-slate-400 transition-transform duration-200"
						:class="{ 'rotate-180': showSettings }"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
					>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
					</svg>
				</button>
				<div id="room-settings" x-show="showSettings" x-cloak class="mt-4 p-4 bg-slate-50 border border-slate-200 rounded-xl space-y-4">
					<p class="text-sm text-slate-600 mb-4">Control who can perform specific actions in this room.</p>
					@PermissionToggles()
				</div>
			</div>
			<!-- Submit Button with Icon -->
			<button
				type="submit"
				class="w-full bg-primary-700 text-white py-4 px-6 rounded-2xl font-bold hover:shadow-2xl hover:shadow-primary-300/50 hover:-translate-y-1 active:translate-y-0 transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-primary-300 focus:ring-offset-2 flex items-center justify-center gap-2"
			>
				<span>Create Room</span>
				<span class="text-xl">→</span>
			</button>
		</form>
		<!-- Quick Start Tip -->
		<div class="mt-6 p-4 bg-accent-50 border border-accent-200 rounded-xl">
			<div class="flex items-start gap-3">
				<span class="text-xl">💡</span>
				<div>
					<p class="text-sm font-medium text-accent-900">Quick Tip</p>
					<p class="text-xs text-accent-700 mt-1">
						Share the room link or QR code with your team after creation
					</p>
				</div>
			</div>
		</div>
	</div>
}


templ planningPokerGuide() {
	<section aria-labelledby="how-it-works" class="space-y-6">
		<h2 id="how-it-works" class="text-2xl font-bold text-slate-900">How online planning poker works</h2>
		<p class="text-slate-600">Planning poker is a way for a team to compare estimates before agreeing on the size of a piece of work. Each person chooses a value independently, then the team reveals the votes and discusses differences. Use this tool alongside your usual call for sprint planning or backlog refinement.</p>
		<ol class="grid md:grid-cols-3 gap-6">
			<li class="elevated-card p-6 bg-white">
				<h3 class="text-lg font-bold text-slate-800 mb-3">1. Create your room</h3>
				<p class="text-slate-600">Give the session a name and choose a voting scale. Join the room with your name first, then send its link or QR code to the rest of your team. Nobody needs to create an account.</p>
			</li>
			<li class="elevated-card p-6 bg-white">
				<h3 class="text-lg font-bold text-slate-800 mb-3">2. Estimate independently</h3>
				<p class="text-slate-600">Discuss the story, then pick a card. Vote values stay hidden until the reveal, while the room shows who has voted. Teammates can join as voters or spectators.</p>
			</li>
			<li class="elevated-card p-6 bg-white">
				<h3 class="text-lg font-bold text-slate-800 mb-3">3. Reveal and discuss</h3>
				<p class="text-slate-600">Reveal the cards together. Compare the estimates, ask about the differences, and decide whether another round would help. Start the next round when the team is ready.</p>
			</li>
		</ol>
	</section>
	<section aria-labelledby="voting-scales" class="space-y-6">
		<h2 id="voting-scales" class="text-2xl font-bold text-slate-900">Choose a voting scale that fits your team</h2>
		<p class="text-slate-600">Use the same scale as your team's existing estimation process. Story points express relative size; the app does not turn them into hours or choose an estimate for you.</p>
		<div class="grid md:grid-cols-3 gap-6">
			<div>
				<h3 class="text-lg font-bold text-slate-800 mb-3">Fibonacci and modified Fibonacci</h3>
				<p class="text-slate-600">Start with a preset such as 1, 2, 3, 5, 8, 13, 21. The modified scale includes values such as 0.5, 20, 40 and 100. Choose it in the room form before the session.</p>
			</div>
			<div>
				<h3 class="text-lg font-bold text-slate-800 mb-3">T-shirt sizes</h3>
				<p class="text-slate-600">Use sizes from XXS to XXL when your team prefers a rough sizing conversation. These are labels rather than numbers, so there is no numeric average to interpret.</p>
			</div>
			<div>
				<h3 class="text-lg font-bold text-slate-800 mb-3">Custom voting values</h3>
				<p class="text-slate-600">Open “Edit the voting values” to enter your own cards, separated by commas. Keep at least two choices, and agree on what the values mean before voting.</p>
			</div>
		</div>
	</section>
	<section aria-labelledby="session-options" class="space-y-6">
		<h2 id="session-options" class="text-2xl font-bold text-slate-900">Keep the session moving</h2>
		<ul class="grid md:grid-cols-2 gap-6">
			<li><h3 class="font-bold text-slate-800 mb-2">Reveal votes together</h3><p class="text-slate-600">Reveal manually, or enable automatic reveal after all voters have chosen a card. The same round updates across the team's browsers in real time.</p></li>
			<li><h3 class="font-bold text-slate-800 mb-2">Choose who runs the round</h3><p class="text-slate-600">Room settings let you decide whether everyone can reveal votes, reset a round or start the next one. You can also allow or lock vote changes after reveal.</p></li>
			<li><h3 class="font-bold text-slate-800 mb-2">Include people who are observing</h3><p class="text-slate-600">Spectators can follow the session without casting a vote. Share one room link with the team rather than asking everyone to register for another service.</p></li>
			<li><h3 class="font-bold text-slate-800 mb-2">Use the results to guide discussion</h3><p class="text-slate-600">Review the vote distribution, agreement percentage and average for numeric votes. An average is a discussion aid; your team still decides the final estimate.</p></li>
		</ul>
	</section>
	<section aria-labelledby="questions" class="space-y-4">
		<h2 id="questions" class="text-2xl font-bold text-slate-900 mb-6">Questions before your first session</h2>
		<details class="rounded-xl border border-slate-200 bg-white p-5"><summary class="cursor-pointer font-semibold text-slate-800">Do I need an account to create or join a room?</summary><p class="mt-3 text-slate-600">No. Create a room and join with a display name. Your teammates use the shared link and enter their names too. There is no email or password step.</p></details>
		<details class="rounded-xl border border-slate-200 bg-white p-5"><summary class="cursor-pointer font-semibold text-slate-800">How long does a planning poker room last?</summary><p class="mt-3 text-slate-600">A room expires 24 hours after it is created. Create a new room for a later session; this is a temporary estimation space rather than a permanent project archive.</p></details>
		<details class="rounded-xl border border-slate-200 bg-white p-5"><summary class="cursor-pointer font-semibold text-slate-800">How many people can join?</summary><p class="mt-3 text-slate-600">A room allows up to 50 participants, including spectators. Everyone joins the same room URL and sees the round update in their browser.</p></details>
		<details class="rounded-xl border border-slate-200 bg-white p-5"><summary class="cursor-pointer font-semibold text-slate-800">Can we use it with a remote or hybrid team?</summary><p class="mt-3 text-slate-600">Yes. Open the room in a browser and keep your usual voice or video call for discussing stories. People in the office and people joining remotely can vote in the same session.</p></details>
		<details class="rounded-xl border border-slate-200 bg-white p-5"><summary class="cursor-pointer font-semibold text-slate-800">When can teammates see my vote?</summary><p class="mt-3 text-slate-600">The room shows that you have voted, but keeps the value hidden until reveal. Room options control who can reveal and whether votes can change afterwards. Share the room link with the people you want to invite.</p></details>
		<details class="rounded-xl border border-slate-200 bg-white p-5"><summary class="cursor-pointer font-semibold text-slate-800">Do we have to use Fibonacci story points?</summary><p class="mt-3 text-slate-600">No. Choose Fibonacci, modified Fibonacci or t-shirt sizes, or enter custom values when you create the room. The important part is that everyone understands the team's scale.</p></details>
	</section>
	<footer class="border-t border-slate-200 pt-8 flex flex-wrap gap-6 text-sm text-slate-600">
		<span>Built by <a href="https://damiengoehrig.ca/" class="underline">Damien Goehrig</a>.</span>
		<a href="#create-room" class="font-semibold text-primary-700 underline">Create a planning poker room</a>
		<a href="https://damiengoehrig.ca/blog/planning-poker-app/" class="underline">Why I built PokerPlanning</a>
		<a href="https://github.com/damione1/planning-poker" class="underline">Source code</a>
		<a href="https://github.com/damione1/planning-poker/issues" class="underline">Report a problem</a>
	</footer>
}
